# Docker Compose版で変えたい値の見本。すべて省略でき、既定値で動く。
# 変えるときは、リポジトリ直下の .env にコピーして書く（docker compose が自動で読む。コミットしない）。
#
#   cp compose.env.example .env
#
# 生成AI（Gemini・OpenAI互換API・Claude など）とAPIキーは、起動後に画面の
# 「マスター管理 → システム設定 → 生成AIの設定」で入れる。ここには書かない。

# 最初に選ばれている生成AI（codex / gemini / openai_compatible / claude）。
# codex は画面の「Codexへログイン」で本人のChatGPTアカウントに接続する（キー不要）。
GENERATOR=gemini

# Codexを全体で使わせないときは false（利用者ごとの停止はマスター管理のユーザー編集で行う）。
CODEX_ENABLED=false

# 管理画面のホスト側ポート（既定8080）。他のComposeアプリと競合する場合に変更する。
# COMPOSE_APP_PORT=8081

# ローカルRegistryのホスト側ポート（既定5000）。
# COMPOSE_REGISTRY_PORT=5000

# ── Docker網（他の網と重なるときだけ変える） ──────────────────
# COMPOSE_SUBNET=172.29.80.0/24
# COMPOSE_GATEWAY=172.29.80.1
# COMPOSE_PREVIEW_SUBNET=172.29.81.0/24
# COMPOSE_PREVIEW_GATEWAY=172.29.81.1

# ── Linuxのみ: docker.sock のグループID（stat -c %g /var/run/docker.sock）。Docker Desktopは不要
# DOCKER_SOCKET_GID=999
