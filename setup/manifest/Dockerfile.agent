FROM node:24-alpine AS cli

# Codexの版は固定し、上げるときは再検証してから変更する。
# AlpineではClaude SDKのwheelにCLIが同梱されない。SDK 0.2.163の同梱CLIと同じ版を固定する。
# npm はベースイメージ同梱の版だと同梱ライブラリの脆弱性が多い。版を固定して上げる。
# 上げた npm で CLI を入れるため、先に npm だけを入れ替える。
RUN npm install --global --no-audit --no-fund npm@12.2.1
# npm 12 は既定で install スクリプトを止める。Claude Code は postinstall で実行部を置くので、
# それだけを許可する。
RUN npm install --global --no-audit --no-fund --allow-scripts=@anthropic-ai/claude-code \
    @openai/codex@0.160.0 @anthropic-ai/claude-code@2.1.286 \
 && npm cache clean --force

# ---
# uv の版は固定する。本体の Dockerfile と揃える。
FROM ghcr.io/astral-sh/uv:0.13.4 AS uv

# ---
# Python の依存は uv.lock のとおりに venv へ入れる。
# 生成エージェント用の extra（antigravity・claude）と、Koyorina 自身の検査に使う test も入れる。
FROM python:3.14-alpine AS python-deps

COPY --from=uv /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    uv sync --locked --no-dev --no-install-project --extra antigravity --extra claude --extra test

# ---
FROM python:3.14-alpine

# ベースイメージ公開後に出た OS パッケージの修正を取り込む。
# 依存の導入は uv で行うので、ベースの pip は消して攻撃面と脆弱性の検出を減らす。
RUN apk upgrade --no-cache \
    && python -m pip uninstall --yes --root-user-action=ignore pip

# UV_PROJECT_ENVIRONMENT はここでは設定しない。生成アプリの uv が /opt/venv を触らないようにする。
ENV USE_BUILTIN_RIPGREP=0 \
    PATH="/opt/venv/bin:$PATH"

# 生成コードの変更履歴を残すために使う。リポジトリは作業場所の外に置くので、
# 生成モデルからは触れない。ネットワークは使わない（ローカルのリポジトリのみ）。
RUN apk add --no-cache bubblewrap git bash libstdc++ ripgrep

WORKDIR /app

COPY --from=cli /usr/local/bin/node /usr/local/bin/node
COPY --from=cli /usr/local/lib/node_modules /usr/local/lib/node_modules

RUN ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
 && ln -s /usr/local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe /usr/local/bin/claude \
 && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY pyproject.toml ./
COPY backend/ ./backend/
COPY Skills/ ./Skills/
COPY setup/manifest/codex-bwrap-no-proc /usr/local/bin/bwrap

# Rocky Linuxのrestricted Podでは、nested PID namespace内のprocマウントだけが
# 拒否される。Codexの公式no-procフォールバックを、固定したbwrap入口で適用する。
RUN chmod 0555 /usr/local/bin/bwrap

# uv は実行時にも使う。生成アプリが宣言した依存は、基盤がこれで作業場所へ導入する
# （プレビュー実行環境と同じ道具に揃える）。
COPY --from=uv /uv /uvx /usr/local/bin/
COPY --from=python-deps /opt/venv /opt/venv

RUN adduser -D -u 10001 forge

USER forge

EXPOSE 8080

CMD ["uvicorn", "backend.worker.agent:create_agent", "--factory", "--host", "0.0.0.0", "--port", "8080", "--no-access-log", "--no-proxy-headers"]
