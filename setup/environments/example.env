# このファイルをコピーして使う: cp example.env dev.env（またはprod.env）
# dev.env / prod.env はコミットしない（.gitignore済み）。実際のドメイン・
# GCPプロジェクト・社内ホスト名を書くため。
#
# 同じ環境名の中では、ここが唯一の置き場にする。マニフェスト・Makefile・
# setup/ansible のいずれも、この値を書き写さず参照する。

# ── マニフェストと Makefile が使う値 ──────────────────────────
# 画面を開く名前。証明書・ヘルスチェック・TrustedHostMiddleware がこの名前で揃う。
# Kubernetesのnamespace・Deployment・Secret等の名前の接頭辞。
# 変えるとリソース名一式が新しい名前に切り替わる。
APP_NAME=koyorina
DOMAIN=koyorina.example.com

# オンプレのgateway.yaml（MetalLB）だけが使う。GCEでは使わないので空でよい。
METALLB_IP=192.0.2.10

# マニフェストが指すイメージの置き場。make push の宛先でもある。
REGISTRY=registry.example.com

# Vertex AI を呼ぶGCPプロジェクト（画面で Gemini を保存するまでの既定）。GCE配備でも使う。
GCP_PROJECT=your-gcp-project-id

CODEX_ENABLED=true

# 公開サービスで開けておくと危ない口。既定（書かない場合）は false。
# 実行管理から、動いているプレビューの中でコマンドを実行する調査用の機能。
PREVIEW_SHELL_ENABLED=false
# 手元のCodexで作ったアプリのZIPを登録する機能（と作業パッケージの取得）。
LOCAL_CODEX_ENABLED=false

# Antigravity と OpenAI 互換 API は、画面（マスター管理 → システム設定 → 生成AIの設定）で
# 有効にする。APIキーもそこで入れる（TENANT_SECRET_KEY で暗号化してDBに保存）。

# 生成とプレビューを載せるノード。seccompプロファイルを置いたノードを指すこと。
AGENT_NODE=k3s-agent-2
# RWX(Filestore/NFS/Ceph等)へ切り替えるときだけ使う。指定するとAGENT_NODEより
# 優先される（例: {"workload": "koyorina-agent"}）。ノードを問わないRWXなら
# 空のままでよい。setup/ansible を使う場合はそちら側の group_vars で
# 管理する方が扱いやすい（forge_storage_mode: nfs|external、
# setup/ansible/group_vars/onprem/defaults.yml のCeph設定例を参照）。
NODE_SELECTOR=
# Ceph(CephFS)ですでにRWXなStorageClassがあるなら STORAGE_CLASS=cephfs、
# STORAGE_ACCESS_MODE=ReadWriteMany にする（AGENT_NODEは空にしてよい）。
STORAGE_CLASS=local-path
STORAGE_ACCESS_MODE=ReadWriteOnce
# GCEのagentノードにはtaintがある。オンプレでは空/falseのままでよい。
AGENT_TOLERATION=false
GENERATION_IMAGE_PULL_SECRET=
PREVIEW_IMAGE_PULL_SECRET=
ENVIRONMENT=dev

# legacy | cilium。Ciliumを導入していないクラスタでは必ずlegacyのままにする
# （contrib/observability/ の手順を実施した場合だけciliumへ変える）。
NETWORK_POLICY_MODE=legacy

AUDIT_LOG_REQUEST_CONTENT=0
AUDIT_CA_CONFIGMAP=

# vertex=Vertex AIのADC / developer=Google AI StudioのAPIキー。
GEMINI_API_BACKEND=developer
VERTEX_API_HOST=aiplatform.googleapis.com

# disabled | splunk_hec | googlecloud。既定は無効
# （splunk_hec/googlecloudを使うにはcontrib/observability/の設定が要る）。
AUDIT_LOG_EXPORTER=disabled
AUDIT_SPLUNK_INDEX=koyorina_audit
AUDIT_GCP_LOG_NAME=koyorina-network-audit


# ── GCE本番の配備スクリプトだけが使う値 ───────────────────────
# 手元のk3sはこの経路を使わないため空でよい。空のまま使おうとすると止まる。
IMAGE_ROOT=
SERVER_NODE=

# 生成アプリの依存の取得元。空にすれば公開レジストリをそのまま使う。
# GMO Takumi Guardや、検査済みの社内ミラーを通す運用なら、ここへそのURLを入れる。
NPM_REGISTRY=
PYPI_INDEX=

# プレビュー1つぶんの枠。要求はノードの空きを押さえる量、上限は使ってよい量。
# 依存の導入とビルドで一時的に伸びるので、要求は控えめ・上限は広めに取る。
# クラスタの大きさが環境で違うので、ここで変える。
PREVIEW_CPU_REQUEST=100m
PREVIEW_CPU_LIMIT=2
PREVIEW_MEMORY_REQUEST=2Gi
PREVIEW_MEMORY_LIMIT=3Gi
