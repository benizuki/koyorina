# Managed by Koyorina; generated Dockerfiles are never used.
FROM node:24-bookworm-slim AS frontend
ARG APP_BASE_PATH
WORKDIR /src/frontend
COPY frontend/package.json ./
RUN npm install --ignore-scripts --no-audit --no-fund
COPY frontend/ ./
RUN npm run build && node_modules/.bin/vite build --base "$APP_BASE_PATH"

FROM python:3.14-slim-trixie AS backend
WORKDIR /src
COPY pyproject.toml ./
RUN python -m venv /opt/venv
COPY platform/install.py /tmp/install.py
RUN /opt/venv/bin/python /tmp/install.py

FROM python:3.14-slim-trixie
ARG SECURITY_UPDATE_ID
RUN test -n "$SECURITY_UPDATE_ID" \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 FRONTEND_DIST=/workspace/frontend/dist PREVIEW_APP_PORT=8081
WORKDIR /workspace
COPY --from=backend /opt/venv /opt/venv
COPY backend/ ./backend/
COPY --from=frontend /src/frontend/dist ./frontend/dist/
COPY platform/front.py platform/entrypoint.sh /opt/publication/
RUN chmod 755 /opt/publication/entrypoint.sh
USER 10001:10001
EXPOSE 8080
CMD ["/opt/publication/entrypoint.sh"]
