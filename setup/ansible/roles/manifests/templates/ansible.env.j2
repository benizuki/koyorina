{# setup/ansible/group_vars から生成。手で編集しない（Ansibleが実行のたびに上書きする）。
   setup/environments/load.py・render.py・apply.sh・pin.py が読む形式に合わせる。 #}
# setup/manifest/*.yaml・setup/gcp/k8s/ingress.yaml が ${APP_NAME} を使う。
# GCEの配備スクリプト(setup/gcp/k8s/*.py)自体は"koyorina"を直接使う設計なので
# ここも固定値でよい（rename: App Forge -> Koyorina 参照）。
APP_NAME={{ forge_app_name }}
DOMAIN={{ forge_domain }}
METALLB_IP={{ forge_metallb_ip }}
REGISTRY={{ forge_registry }}
GCP_PROJECT={{ forge_gcp_project }}
ENVIRONMENT={{ forge_environment }}
NETWORK_POLICY_MODE={{ forge_network_policy_mode }}
GEMINI_API_BACKEND={{ forge_gemini_api_backend }}
VERTEX_API_HOST={{ forge_vertex_api_host }}
CODEX_ENABLED={{ forge_codex_enabled | lower }}

AUDIT_LOG_REQUEST_CONTENT={{ 1 if forge_audit_log_request_content else 0 }}
AUDIT_CA_CONFIGMAP={{ forge_audit_ca_configmap }}
AUDIT_LOG_EXPORTER={{ forge_audit_log_exporter }}
AUDIT_SPLUNK_INDEX={{ forge_audit_splunk_index }}
AUDIT_GCP_LOG_NAME={{ forge_audit_gcp_log_name }}

NPM_REGISTRY={{ forge_npm_registry }}
PYPI_INDEX={{ forge_pypi_index }}

PREVIEW_CPU_REQUEST={{ forge_preview_cpu_request }}
PREVIEW_CPU_LIMIT={{ forge_preview_cpu_limit }}
PREVIEW_MEMORY_REQUEST={{ forge_preview_memory_request }}
PREVIEW_MEMORY_LIMIT={{ forge_preview_memory_limit }}

# ── ノード選択とストレージ(RWX/Filestore対応) ─────────────────
AGENT_NODE={{ forge_agent_node if not forge_node_selector else "" }}
NODE_SELECTOR={{ forge_node_selector | to_json if forge_node_selector else "" }}
STORAGE_CLASS={{ forge_storage_class }}
STORAGE_ACCESS_MODE={{ forge_storage_access_mode }}
AGENT_TOLERATION={{ forge_agent_toleration | lower }}
GENERATION_IMAGE_PULL_SECRET={{ forge_generation_image_pull_secret }}
PREVIEW_IMAGE_PULL_SECRET={{ forge_preview_image_pull_secret }}

# ── GCE本番の配備スクリプトだけが使う値(オンプレでは空でよい) ────
IMAGE_ROOT={{ forge_image_root }}
SERVER_NODE={{ forge_server_node }}
