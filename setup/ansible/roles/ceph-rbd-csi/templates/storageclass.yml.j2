apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: {{ forge_ceph_rbd_storage_class }}
provisioner: rbd.csi.ceph.com
parameters:
  clusterID: {{ forge_ceph_rbd_cluster_id | to_json }}
  pool: {{ forge_ceph_rbd_pool | to_json }}
  imageFeatures: layering
  csi.storage.k8s.io/fstype: ext4
  csi.storage.k8s.io/provisioner-secret-name: ceph-rbd-csi
  csi.storage.k8s.io/provisioner-secret-namespace: ceph-rbd-csi
  csi.storage.k8s.io/controller-expand-secret-name: ceph-rbd-csi
  csi.storage.k8s.io/controller-expand-secret-namespace: ceph-rbd-csi
  csi.storage.k8s.io/node-stage-secret-name: ceph-rbd-csi
  csi.storage.k8s.io/node-stage-secret-namespace: ceph-rbd-csi
reclaimPolicy: Delete
volumeBindingMode: WaitForFirstConsumer
allowVolumeExpansion: true
